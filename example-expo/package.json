{
  "name": "linkme-rn-example",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e:build": "detox build --configuration ios.debug",
    "e2e:test": "detox test --configuration ios.debug",
    "e2e:build:release": "detox build --configuration ios.release",
    "e2e:test:release": "detox test --configuration ios.release"
  },
  "dependencies": {
    "@li-nk.me/react-native-sdk": "file:..",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "detox": "^20.51.4",
    "jest": "^30.5.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "decode-uri-component": "0.5.0"
  }
}
